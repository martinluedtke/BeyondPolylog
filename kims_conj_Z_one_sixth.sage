r"""
Verify Kim's Conjecture for the thrice-punctured line over ℤ[1/6] for all primes p 
up to a given bound. The code computes the Chabauty—Kim locus in X(ℤₚ) for the 
full level 4 quotient of the fundamental group and verifies that it contains
only the 21 solutions of the S-unit equation for S={2,3}. This proves Theorem 5.21
of [CDCL26].

The abstract Kim functions for #S=2 are read from the file "abstract_kim_functions.sobj"
which was generated by "abstract_kim_functions.sage".

REFERENCES:

    [CDCL26] David Corwin, Ishai Dan-Cohen, Martin Lüdtke, "Mixed Tate Chabauty—Kim beyond 
        the polylog quotient", https://arxiv.org/abs/2610.25365v2

AUTHOR:

    - Martin Lüdtke (2026-11-01)

"""

load("BeyondPolylog.sage")

prime_bound = 1000
prec = 10

abstract_kim_functions = load("abstract_kim_functions.sobj")

s_unit_sols = [
    2, -1, 1/2, 
    3, 1/3, 2/3, 3/2, -1/2, -2, 
    4, 1/4, 3/4, 4/3, -1/3, -3, 
    9, 1/9, 8/9, 9/8, -1/8, -8
]

@parallel
def check_prime(p):
    li_data =  polylog_data(4,p,prec)
    kim_functions = Z_one_sixth_kim_functions_poly(p,prec,abstract_kim_functions,li_data)
    try:
        locus = compute_depth4_locus(kim_functions,li_data)
    except PrecisionError:
        print(f"p = {p}: PrecisionError")
    else:
        if len(locus) < len(s_unit_sols):
            print(f"p = {p}: something is wrong, locus contains only {len(locus)} points!")
        elif len(locus) == len(s_unit_sols):
            print(f"p = {p}: ✓")
        else:
            print(f"p = {p}: locus contains extra points:")
            for z in locus:
                if z not in s_unit_sols:
                    print(f"  {z}")

for _ in check_prime(prime_range(5,prime_bound)):
    pass
